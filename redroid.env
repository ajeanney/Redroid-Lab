# Runtime identity
BASE_IMAGE=redroid/redroid@sha256:11d58a64bfbde2253d1cce81bff409ff58174980222d1bada232d9ef59181191
LOCAL_IMAGE=redroid-lab:14
CONTAINER_NAME=redroid14-bt

# Host integration
ADB_HOST=127.0.0.1
ADB_PORT=5555
BT_ADAPTER=hci0
# Optional guard: refuse to take over any adapter whose USB vendor:product differs
BT_EXPECTED_USB_ID=
NFT_TABLE=redroid_guard
HOST_NETNS_SOURCE=/proc/1/ns/net
REDROID_DATA_DIR=./data
SNAPSHOT_DIR=./snapshots

# Virtual display
REDROID_WIDTH=1080
REDROID_HEIGHT=1920
REDROID_DPI=420
REDROID_FPS=60
REDROID_GPU_MODE=host
REDROID_NATIVE_BRIDGE=libndk_translation.so

# AOSP generated camera scene, without using the host webcam; 0 exposes no cameras.
CAMERA_ENABLE=1

# Startup timeout in seconds
BOOT_TIMEOUT=180

# Bluetooth passthrough: 1 reserves BT_ADAPTER for Android, 0 leaves it to the host
# (`./redroid.sh start --no-bt` overrides this for one run)
BT_ENABLE=1

# Packet capture: session output directory and preferred mitmproxy port
CAPTURE_DIR=./captures
MITM_PORT=8080
# Transparent capture: table in Android's netns and a proxy-only socket group
CAPTURE_NFT_TABLE=redroid_capture
MITM_GID=2147483647

# Frida: guest and host-forwarded (loopback only) port of frida-server
FRIDA_PORT=27042

# APK extraction and optional static analysis output
PULL_DIR=./apps

# Private live app-data pulls and diffs (Android user 0)
APPDATA_DIR=./appdata

# Optional startup identity overrides. Empty preserves the image's property.
# Quote values containing spaces; use redroid.local.env for your profile.
REDROID_MODEL=
REDROID_MANUFACTURER=
REDROID_BRAND=
REDROID_DEVICE=
REDROID_PRODUCT=
REDROID_FINGERPRINT=
# Empty, 0 or 1; this only changes ro.kernel.qemu, not hardware attestation.
REDROID_QEMU=
