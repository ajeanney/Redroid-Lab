# Persistent Android state (contains apps, credentials, bonds, and user data)
/data/

# Packet capture sessions (pcaps, decoded flows, TLS keys)
/captures/

# Lifecycle state, generated smoke APK, HCI snoops, and diagnostics
/.runtime/

# Local build/download caches
/.cache/

# Machine-specific configuration overrides
redroid.local.env
*.local.env

# Machine-specific agent instructions
AGENTS.local.md
*.local.md

# Generated Android packages and signing material
*.apk
*.aab
*.apks
*.idsig
*.keystore
*.jks

# Logs and process artifacts
*.log
*.pid
*.pid.lock

# IDE, editor, and operating-system metadata
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
